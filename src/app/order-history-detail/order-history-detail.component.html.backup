<div class="top-spacing"></div>

<div class="order-detail-container page-shell" *ngIf="!isLoading && order; else loadingOrError">
  <div class="items-scroll">
    <table class="order-table">
      <colgroup>
        <col />
        <col class="quantity-column" />
        <col class="return-reason-column" />
        <col class="total-column" />
      </colgroup>
      <thead>
        <tr>
          <th>Product</th>
          <th>Quantity</th>
          <th *ngIf="returnRequestMode">Return Reason</th>
          <th>Total</th>
        </tr>
      </thead>
      <tbody>
        <tr *ngFor="let item of order.orderItems; let itemIndex = index">
          <td class="product-info">
            <input
              *ngIf="returnRequestMode"
              type="checkbox"
              [checked]="isReturnItemSelected(itemIndex)"
              [attr.aria-label]="'Select ' + getProductDisplayTitle(item.film) + ' for return request'"
              (change)="onReturnItemSelectionChange(itemIndex, $event)"
            />
            <a
              [routerLink]="getProductLink(item.film)"
              [fragment]="getProductFragment(item.film)"
              class="product-image-link"
            >
              <span class="product-image-wrap">
                <img [src]="getProductImageUrl(item.film)" [alt]="getProductDisplayTitle(item.film)" class="product-image" />
              </span>
            </a>
            <div class="product-details">
              <div class="product-title">{{ getProductDisplayTitle(item.film) }}</div>
              <div class="product-brand">{{ getProductDisplayBrand(item.film) }}</div>
              <div class="product-type">{{ getProductDisplayType(item.film) }}</div>
            </div>
          </td>
          <td>{{ item.quantity }}</td>
          <td>€ {{ (item.price * item.quantity).toFixed(2) }}</td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="purchase-summary">
    <p class="summary-line"><strong>Purchase date:</strong> {{ order.orderDate | date:'medium' }}</p>
    <p class="summary-line"><strong>Subtotal:</strong> € {{ getSubtotal().toFixed(2) }}</p>
    <p *ngIf="returnRequestMode" class="summary-line">
      <strong>Selected for return:</strong> {{ getSelectedReturnItemCount() }}
    </p>
    <p *ngIf="submittedReturnItemCount !== null" class="summary-line">
      <strong>Return request submitted:</strong>
      {{ submittedReturnItemCount }} item{{ submittedReturnItemCount === 1 ? '' : 's' }}
    </p>
    <p *ngIf="hasDiscount()" class="summary-line summary-line--discount">
      <strong>{{ getDiscountLabel() }}</strong> (€ {{ getDiscountAmount().toFixed(2) }})
    </p>
    <p *ngIf="getAppliedCodes().length" class="summary-line">
      <strong>Applied code{{ getAppliedCodes().length > 1 ? 's' : '' }}:</strong>
      {{ getAppliedCodes().join(', ') }}
    </p>
    <p class="summary-line"><strong>Already paid:</strong> € {{ getPaidAmount().toFixed(2) }}</p>
  </div>

  <div class="return-request-section" *ngIf="returnRequestMode && getSelectedReturnItemCount() > 0">
    <div class="return-reason-container">
      <label for="returnReason" class="return-reason-label">
        <strong>Return Reason:</strong>
      </label>
      <textarea
        id="returnReason"
        [(ngModel)]="returnReasonText"
        class="return-reason-textbox"
        placeholder="Please explain why you want to return these items..."
        rows="4"
        required
      ></textarea>
      <div *ngIf="returnReasonError" class="error-message">
        {{ returnReasonError }}
      </div>
    </div>
  </div>

  <div class="bottom-actions">
    <button *ngIf="!returnRequestMode" type="button" class="back-button" (click)="toggleReturnRequestMode()">
      Return Request
    </button>
    <button *ngIf="returnRequestMode" type="button" class="back-button" (click)="cancelReturnRequest()">
      Cancel
    </button>
    <button
      *ngIf="returnRequestMode"
      type="button"
      class="back-button"
      [disabled]="getSelectedReturnItemCount() === 0 || !returnReasonText.trim() || isSubmitting"
      (click)="submitReturnRequest()"
    >
      {{ isSubmitting ? 'Submitting...' : 'Submit' }}
    </button>
  </div>

  <div *ngIf="successMessage" class="success-message">
    {{ successMessage }}
  </div>
  <div *ngIf="errorMessage" class="error-message">
    {{ errorMessage }}
  </div>

</div>

<ng-template #loadingOrError>
  <div *ngIf="isLoading">Laden...</div>
  <div *ngIf="error">{{ error }}</div>
</ng-template>
